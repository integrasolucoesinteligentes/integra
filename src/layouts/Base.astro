---
import content from '../content/content.pt-BR.json';
const { title = content.site.title, description = content.site.description, path = '/', noindex = false } = Astro.props;
const site = (Astro.site ?? new URL('https://integrasolucoesinteligentes.com')).toString().replace(/\/$/, '');
const canonical = site + path;
const ogImage = site + '/og-image-1200x630.jpg';
// noindex automático em qualquer ambiente da Vercel que não seja produção (prévias)
const isPreview = !!process.env.VERCEL_ENV && process.env.VERCEL_ENV !== 'production';
const forceNoindex = noindex || isPreview;
const c = content.contact;
const sameAs = [c.instagram, c.linkedinCompany].filter(Boolean);
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: content.site.name,
  alternateName: content.site.shortName,
  url: site + '/',
  logo: site + '/icon-512.png',
  image: ogImage,
  description: content.seo.organizationDescription,
  slogan: content.site.tagline,
  email: c.email,
  telephone: '+' + c.whatsappNumber,
  address: { '@type': 'PostalAddress', addressLocality: content.site.locality, addressRegion: content.site.region, addressCountry: content.site.country },
  areaServed: { '@type': 'Country', name: 'Brasil' },
  knowsAbout: content.seo.knowsAbout,
  founder: { '@type': 'Person', name: content.about.people[0].name, jobTitle: content.about.people[0].role },
  contactPoint: [{ '@type': 'ContactPoint', contactType: 'customer service', telephone: '+' + c.whatsappNumber, email: c.email, availableLanguage: 'pt-BR' }],
  ...(sameAs.length ? { sameAs } : {}),
};
---
<!doctype html>
<html lang={content.site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={forceNoindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#060D1A" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/outfit-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/outfit-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={content.site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={content.site.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
  </head>
  <body>
    <slot />
  </body>
</html>
