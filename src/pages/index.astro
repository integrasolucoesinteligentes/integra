---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import content from '../content/content.pt-BR.json';
const { hero, pillars, process, audience, differentials, about, cta, form: f, contact: c } = content;
const wa = `https://wa.me/${c.whatsappNumber}?text=${encodeURIComponent(c.whatsappMessage)}`;
const mail = `mailto:${c.email}?subject=${encodeURIComponent(c.emailSubject)}&body=${encodeURIComponent(c.emailBody)}`;
const initial = (n: string) => n.trim().charAt(0).toUpperCase();
---
<Base path="/">
  <Header home />
  <main id="conteudo">
    <section class="hero" aria-labelledby="h-hero">
      <div class="container">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1 id="h-hero">{hero.headlinePre} <span class="l2"><strong>{hero.headlineStrong}</strong></span></h1>
        <p class="sub">{hero.subhead}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={wa} target="_blank" rel="noopener noreferrer">{hero.ctaPrimary}<span class="sr-only"> (abre em nova aba)</span></a>
          <a class="btn btn-ghost" href={mail}>{hero.ctaSecondary}</a>
        </div>
        <p class="note">{hero.note}</p>
      </div>
    </section>

    <section id="para-quem" aria-labelledby="h-aud">
      <div class="container aud">
        <div class="sec-head" style="margin-bottom:0">
          <p class="eyebrow">{audience.eyebrow}</p>
          <h2 id="h-aud">{audience.title}<strong>{audience.titleStrong}</strong></h2>
          <p class="lead">{audience.intro}</p>
        </div>
        <div class="card box">
          <h3>{audience.signalsTitle}</h3>
          <ul class="signals">{audience.signals.map((s) => <li>{s}</li>)}</ul>
          <p class="fit">{audience.fitNote}</p>
        </div>
      </div>
    </section>

    <section id="pilares" class="dark-2" aria-labelledby="h-pilares">
      <div class="container">
        <div class="sec-head">
          <p class="eyebrow">{pillars.eyebrow}</p>
          <h2 id="h-pilares">{pillars.title}<strong>{pillars.titleStrong}</strong></h2>
          <p class="lead">{pillars.intro}</p>
        </div>
        <ul class="pillars">
          {pillars.items.map((p, i) => (
            <li class="card pillar">
              <span class="num">0{i + 1}</span>
              <h3>{p.name}</h3>
              <p class="lead">{p.lead}</p>
              <p class="txt">{p.text}</p>
              <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="como-trabalhamos" class="light" aria-labelledby="h-proc">
      <div class="container">
        <div class="sec-head">
          <p class="eyebrow">{process.eyebrow}</p>
          <h2 id="h-proc">{process.title}<strong>{process.titleStrong}</strong></h2>
          <p class="lead">{process.intro}</p>
        </div>
        <ol class="steps">
          {process.steps.map((s) => (
            <li class="step"><div class="n" aria-hidden="true">{s.n}</div><h3>{s.title}</h3><p>{s.text}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section id="diferenciais" class="light" aria-labelledby="h-diff">
      <div class="container">
        <div class="sec-head">
          <p class="eyebrow">{differentials.eyebrow}</p>
          <h2 id="h-diff">{differentials.title}<strong>{differentials.titleStrong}</strong></h2>
        </div>
        <ul class="diffs">
          {differentials.items.map((d) => <li class="diff"><h3>{d.title}</h3><p>{d.text}</p></li>)}
        </ul>
      </div>
    </section>

    <section id="sobre" class="dark-2" aria-labelledby="h-sobre">
      <div class="container about">
        <div>
          <div class="sec-head" style="margin-bottom:24px">
            <p class="eyebrow">{about.eyebrow}</p>
            <h2 id="h-sobre">{about.title}<strong>{about.titleStrong}</strong></h2>
          </div>
          <div class="txt">{about.text.map((t) => <p>{t}</p>)}</div>
        </div>
        <ul class="people">
          {about.people.map((p, i) => (
            <li class="card person">
              <div class="avatar" aria-hidden="true">{initial(p.name)}</div>
              <div>
                <h3>{p.name}</h3>
                <p class="role">{p.role}</p>
                <p class="bio">{p.bio}</p>
                {(i === 0 ? c.linkedinFounder : p.linkedin) && <p class="links"><a href={i === 0 ? c.linkedinFounder : p.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn de ${p.name}`}>LinkedIn</a></p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="contato" class="cta" aria-labelledby="h-cta">
      <div class="container">
        <h2 id="h-cta">{cta.title}<strong>{cta.titleStrong}</strong></h2>
        <p class="t">{cta.text}</p>
        <div class="row">
          <a class="btn btn-primary" href={wa} target="_blank" rel="noopener noreferrer">{cta.primary}<span class="sr-only"> (abre em nova aba)</span></a>
          <a class="btn btn-ghost" href={mail}>{cta.secondary}</a>
        </div>
        <p class="hint">{cta.hint}</p>

        <form class="contact-form" id="form-contato" method="post" action={c.formEndpoint} novalidate data-endpoint={c.formEndpoint}>
          <h3>{f.title}</h3>
          <div class="grid">
            <label>{f.labels.nome}<input name="nome" type="text" autocomplete="name" required maxlength="120" /></label>
            <label>{f.labels.empresa}<input name="empresa" type="text" autocomplete="organization" maxlength="160" /></label>
            <label>{f.labels.email}<input name="email" type="email" autocomplete="email" required maxlength="160" /></label>
            <label>{f.labels.whatsapp}<input name="whatsapp" type="tel" autocomplete="tel" maxlength="30" /></label>
          </div>
          <label>{f.labels.interesse}
            <select name="interesse">
              <option value="">{f.interesseDefault}</option>
              {f.interesseOptions.map((o) => <option value={o}>{o}</option>)}
            </select>
          </label>
          <label>{f.labels.mensagem}<textarea name="mensagem" rows="5" required maxlength="2000"></textarea></label>
          <div class="hp" aria-hidden="true"><label>Não preencha este campo<input name="website" type="text" tabindex="-1" autocomplete="off" /></label></div>
          <label class="check"><input name="consentimento" type="checkbox" required /> <span>{f.consent} <a href="/privacidade/" target="_blank" rel="noopener">{f.consentLink}</a>. {f.retention}</span></label>
          <button class="btn btn-primary" type="submit" data-sending={f.sending}>{f.submit}</button>
          <p class="form-status" role="status" aria-live="polite" data-success={f.success} data-error={f.error}></p>
        </form>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script is:inline>
(function () {
  var form = document.getElementById('form-contato');
  if (!form) return;
  var status = form.querySelector('.form-status');
  var btn = form.querySelector('button[type=submit]');
  var label = btn.textContent;
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    status.className = 'form-status';
    status.textContent = '';
    var d = new FormData(form);
    var nome = String(d.get('nome') || '').trim();
    var email = String(d.get('email') || '').trim();
    var msg = String(d.get('mensagem') || '').trim();
    if (nome.length < 2 || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email) || msg.length < 5 || !form.consentimento.checked) {
      status.className = 'form-status err';
      status.textContent = 'Preencha nome, e-mail e mensagem e marque a concordância com a política de privacidade.';
      return;
    }
    btn.disabled = true;
    btn.textContent = btn.getAttribute('data-sending');
    var body = {
      nome: nome, empresa: d.get('empresa'), email: email, whatsapp: d.get('whatsapp'),
      interesse: d.get('interesse'), mensagem: msg, website: d.get('website'),
      consentimento: form.consentimento.checked
    };
    fetch(form.getAttribute('data-endpoint'), {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
    }).then(function (r) {
      if (!r.ok) throw new Error('http ' + r.status);
      form.reset();
      status.className = 'form-status ok';
      status.textContent = status.getAttribute('data-success');
    }).catch(function () {
      status.className = 'form-status err';
      status.textContent = status.getAttribute('data-error');
    }).then(function () {
      btn.disabled = false;
      btn.textContent = label;
    });
  });
})();
</script>
